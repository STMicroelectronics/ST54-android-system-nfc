// NFC Flag definitions
aconfig_declarations {
    name: "aconfig_system_nfc_st",
    package: "com.android.nfc.st.nci.flags",
    container: "system_ext",
    srcs: ["flags.aconfig"],
}

cc_aconfig_library {
    name: "libnfc-nci_flags_st",
    aconfig_declarations: "aconfig_system_nfc_st",
    host_supported: true,
    system_ext_specific: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.nfcservices",
    ],
}
